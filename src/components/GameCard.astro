---
import Crt from './Crt.astro';
import Scene from './Scene.astro';
import { url } from '../lib/url';
import { GENRES, DEVELOPERS } from '../lib/taxonomy';
import { thumbOf, type Game } from '../lib/games';
import { resolveMedia } from '../lib/media';
interface Props { game: Game; }
const { game } = Astro.props;
const d = game.data;
const thumb = thumbOf(game);
const box = resolveMedia(game.id, d.media).aes;
const search = [d.title, d.titleZh, d.titleJa, d.developerName, d.subgenre, String(d.year)].filter(Boolean).join(' ').toLowerCase();
---
<a
  href={url(`/games/${game.id}/`)}
  class="game-card group block bg-ng-panel border-2 border-ng-line shadow-[4px_4px_0_#000]"
  data-sfx="chime"
  data-year={d.year}
  data-genre={d.genre}
  data-dev={d.developer}
  data-title={d.title}
  data-search={search}
>
  {box ? (
    <div class="m-2.5 mb-0 aspect-[512/700] overflow-hidden bg-black border border-black shadow-[0_0_0_1px_#26272f]">
      <img src={box} alt={`${d.title} AES 盒裝封面`} loading="lazy" decoding="async" class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]" />
    </div>
  ) : (
    <Crt class="m-2.5 mb-0">
      {thumb ? <img src={thumb} alt={`${d.title} 遊戲截圖`} loading="lazy" decoding="async" /> : <Scene slug={game.id} genre={d.genre} subgenre={d.subgenre} />}
    </Crt>
  )}
  <div class="p-3 pt-3.5 space-y-2">
    <div class="flex items-center justify-between gap-2 font-vt text-lg leading-none">
      <span class="text-ng-yellow tabular-nums">{d.year}</span>
      <span class="text-ng-mute truncate">{DEVELOPERS[d.developer].name === 'OTHERS' ? d.developerName : DEVELOPERS[d.developer].name}</span>
    </div>
    <h3 class="font-bold text-[15px] leading-snug text-white group-hover:text-ng-yellow line-clamp-2">{d.title}</h3>
    {d.titleZh && <p class="text-sm text-ng-mute leading-snug line-clamp-1">{d.titleZh}</p>}
    <p class="flex flex-wrap gap-1.5 pt-1">
      <span class="font-pixel text-[7px] px-1.5 py-1 bg-ng-blue text-white">{GENRES[d.genre].en.split(' ')[0]}</span>
      <span class="text-[11px] px-1.5 py-0.5 border border-ng-line text-ng-mute">{d.subgenre}</span>
    </p>
  </div>
</a>
