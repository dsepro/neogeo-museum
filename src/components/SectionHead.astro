---
interface Props { no?: string; en: string; zh: string; id?: string; note?: string; }
const { no, en, zh, id, note } = Astro.props;
---
<header id={id} class="scroll-mt-24 flex flex-wrap items-end gap-x-4 gap-y-2 border-b-2 border-ng-line pb-3 mb-6">
  {no && <span class="font-vt text-3xl leading-none text-ng-blue-hi tabular-nums">{no}</span>}
  <h2 class="font-pixel text-sm sm:text-base text-ng-yellow leading-none">{en}</h2>
  <span class="text-lg font-bold text-white leading-none">{zh}</span>
  {note && <span class="ml-auto text-xs text-ng-mute">{note}</span>}
  <slot />
</header>
