---
interface Props { tracks: { title: string; src: string }[]; slug: string; genre: string; title: string; }
const { tracks, slug, genre, title } = Astro.props;
const demo = tracks.length === 0;
const list = demo
  ? [
      { title: 'DEMO LOOP A — 原創合成示範', src: 'demo:0' },
      { title: 'DEMO LOOP B — 原創合成示範', src: 'demo:1' },
    ]
  : tracks;
---
<div class="border-2 border-ng-line bg-ng-panel" data-ost data-seed={slug} data-genre={genre}>
  <div class="flex items-center gap-4 p-4 border-b-2 border-ng-line bg-black">
    <button type="button" class="grid place-items-center w-14 h-14 shrink-0 rounded-full bg-ng-red shadow-[inset_0_-4px_0_rgba(0,0,0,.35),3px_3px_0_#000] hover:bg-ng-red-hi" data-ost-toggle aria-label="播放 / 暫停">
      <svg width="20" height="20" viewBox="0 0 10 10" shape-rendering="crispEdges" aria-hidden="true">
        <g data-ico-play fill="#fff"><rect x="2" y="1" width="2" height="8"/><rect x="4" y="2" width="2" height="6"/><rect x="6" y="3" width="2" height="4"/><rect x="8" y="4" width="1" height="2"/></g>
        <g data-ico-pause fill="#fff" style="display:none"><rect x="2" y="1" width="2" height="8"/><rect x="6" y="1" width="2" height="8"/></g>
      </svg>
    </button>
    <div class="min-w-0 flex-1">
      <p class="font-pixel text-[8px] text-ng-mute mb-1.5">NOW PLAYING · {title}</p>
      <p class="font-vt text-2xl text-ng-yellow leading-none truncate" data-ost-now>{list[0].title}</p>
      <div class="mt-2.5 h-2 bg-ng-line relative overflow-hidden" aria-hidden="true"><div class="absolute inset-y-0 left-0 bg-ng-blue-hi w-0" data-ost-bar></div></div>
    </div>
    <div class="hidden sm:flex items-end gap-[3px] h-10 w-20" aria-hidden="true" data-ost-eq>
      {Array.from({ length: 10 }).map(() => <span class="w-[5px] bg-ng-yellow h-1 transition-[height] duration-75"></span>)}
    </div>
  </div>
  <ol class="divide-y divide-ng-line">
    {list.map((t, i) => (
      <li>
        <button type="button" class="w-full text-left flex items-center gap-3 px-4 py-2.5 hover:bg-ng-panel2 aria-[current=true]:bg-ng-blue/25" data-ost-track={i} data-src={t.src} data-title={t.title} aria-current={i === 0 ? 'true' : 'false'}>
          <span class="font-vt text-xl text-ng-mute w-8 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-sm text-ng-text">{t.title}</span>
        </button>
      </li>
    ))}
  </ol>
  {demo && (
    <p class="px-4 py-3 text-xs text-ng-mute border-t-2 border-ng-line leading-relaxed">
      尚未放入原聲音檔，目前播放的是以 Web Audio 即時合成的<strong class="text-ng-text">原創示範旋律（非遊戲原曲）</strong>。把取得授權的音檔放進 <code class="text-ng-text">public/media/games/{slug}/ost/</code>（如 <code>01 Title.mp3</code>）即會自動列出。
    </p>
  )}
</div>

<script>
  import { audio } from '../scripts/sfx';

  type Ctl = { stop(): void };
  const midi = (n: number) => 440 * Math.pow(2, (n - 69) / 12);
  function rng(str: string) {
    let s = 0; for (const c of str) s = (Math.imul(s ^ c.charCodeAt(0), 2654435761) >>> 0);
    return () => { s = (s + 0x6d2b79f5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  }
  const STYLE: Record<string, { bpm: number; scale: number[]; prog: number[]; root: number }> = {
    fighting: { bpm: 152, scale: [0, 3, 5, 7, 10, 12, 15], prog: [0, 8, 10, 7], root: 45 },
    action: { bpm: 164, scale: [0, 2, 3, 5, 7, 9, 10, 12], prog: [0, 10, 8, 10], root: 43 },
    'sports-puzzle': { bpm: 132, scale: [0, 2, 4, 7, 9, 12, 14], prog: [0, 9, 5, 7], root: 48 },
  };

  /** 原創 4 小節 chiptune 示範：方波主旋律 + 三角波貝斯 + 噪音 hi-hat */
  function demo(seed: string, genre: string, onStep: (lvl: number[]) => void): Ctl {
    const { ctx, out } = audio();
    const st = STYLE[genre] ?? STYLE.fighting;
    const R = rng(seed);
    const step = 60 / st.bpm / 4;
    const mel = Array.from({ length: 32 }, (_, i) => (R() < (i % 4 === 0 ? 0.9 : 0.5) ? st.scale[Math.floor(R() * st.scale.length)] : null));
    const noise = ctx.createBuffer(1, ctx.sampleRate * 0.05, ctx.sampleRate);
    noise.getChannelData(0).forEach((_, i, a) => (a[i] = Math.random() * 2 - 1));
    const bus = ctx.createGain(); bus.gain.value = 0.9; bus.connect(out);
    const note = (f: number, t: number, d: number, type: OscillatorType, v: number) => {
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type = type; o.frequency.value = f;
      g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(0.0001, t + d);
      o.connect(g).connect(bus); o.start(t); o.stop(t + d + 0.02);
    };
    let i = 0, next = ctx.currentTime + 0.08;
    const timer = window.setInterval(() => {
      while (next < ctx.currentTime + 0.12) {
        const bar = Math.floor(i / 16) % 4, s = i % 16;
        const chord = st.root + st.prog[bar];
        if (s % 2 === 0) note(midi(chord + (s % 4 === 0 ? 0 : 12)), next, step * 1.8, 'triangle', 0.22);
        const m = mel[i % 32];
        if (m !== null) note(midi(chord + 24 + m), next, step * (R() > 0.7 ? 3 : 1.6), 'square', 0.06);
        if (s % 2 === 1 || genre !== 'sports-puzzle') {
          const src = ctx.createBufferSource(), g = ctx.createGain(), hp = ctx.createBiquadFilter();
          hp.type = 'highpass'; hp.frequency.value = 7000; src.buffer = noise;
          g.gain.setValueAtTime(s % 4 === 2 ? 0.12 : 0.05, next); g.gain.exponentialRampToValueAtTime(0.0001, next + 0.04);
          src.connect(hp).connect(g).connect(bus); src.start(next);
        }
        if (s === 4 || s === 12) note(midi(chord), next, 0.12, 'sawtooth', 0.05); // snare-ish
        const lvl = Array.from({ length: 10 }, (_, k) => (m !== null ? 0.3 + R() * 0.7 : 0.1 + R() * 0.3) * (k % 3 === s % 3 ? 1 : 0.6));
        const at = next;
        window.setTimeout(() => onStep(lvl), Math.max(0, (at - ctx.currentTime) * 1000));
        next += step; i++;
      }
    }, 25);
    return { stop() { clearInterval(timer); bus.gain.setTargetAtTime(0, ctx.currentTime, 0.03); setTimeout(() => bus.disconnect(), 300); } };
  }

  let current: { root: HTMLElement; ctl?: Ctl; el?: HTMLAudioElement } | null = null;
  function stopAll() {
    if (!current) return;
    current.ctl?.stop(); current.el?.pause();
    setUi(current.root, false);
    current = null;
  }
  function setUi(root: HTMLElement, playing: boolean) {
    (root.querySelector('[data-ico-play]') as SVGElement).style.display = playing ? 'none' : '';
    (root.querySelector('[data-ico-pause]') as SVGElement).style.display = playing ? '' : 'none';
    if (!playing) root.querySelectorAll<HTMLElement>('[data-ost-eq] span').forEach((b) => (b.style.height = '4px'));
  }

  function start(root: HTMLElement, idx: number) {
    stopAll();
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-ost-track]')];
    const b = btns[idx]; if (!b) return;
    btns.forEach((x) => x.setAttribute('aria-current', String(x === b)));
    root.querySelector('[data-ost-now]')!.textContent = b.dataset.title!;
    root.dataset.idx = String(idx);
    const bar = root.querySelector<HTMLElement>('[data-ost-bar]')!;
    const eq = [...root.querySelectorAll<HTMLElement>('[data-ost-eq] span')];
    const src = b.dataset.src!;
    if (src.startsWith('demo:')) {
      let n = 0;
      const ctl = demo(root.dataset.seed! + src, root.dataset.genre!, (lvl) => {
        eq.forEach((e, k) => (e.style.height = `${Math.round(lvl[k] * 40)}px`));
        n++; bar.style.width = `${((n % 64) / 64) * 100}%`;
      });
      current = { root, ctl };
    } else {
      const el = new Audio(src);
      el.addEventListener('timeupdate', () => { bar.style.width = `${(el.currentTime / (el.duration || 1)) * 100}%`; eq.forEach((e) => (e.style.height = `${6 + Math.random() * 30}px`)); });
      el.addEventListener('ended', () => start(root, (idx + 1) % btns.length));
      el.play().catch(() => setUi(root, false));
      current = { root, el };
    }
    setUi(root, true);
  }

  document.addEventListener('astro:before-swap', stopAll);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-ost]').forEach((root) => {
      root.querySelector('[data-ost-toggle]')!.addEventListener('click', () => {
        if (current?.root === root) stopAll(); else start(root, Number(root.dataset.idx || 0));
      });
      root.querySelectorAll<HTMLButtonElement>('[data-ost-track]').forEach((b) =>
        b.addEventListener('click', () => start(root, Number(b.dataset.ostTrack))),
      );
    });
  });
</script>
